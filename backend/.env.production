NODE_ENV=production
PORT=3000

DB_HOST=172.17.0.5
DB_PORT=3306
DB_USER=webuser
DB_PASSWORD=xxxxxxx
DB_DATABASE=corporate_website

# ⚠️生产绝对关闭自动同步
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# bcrypt
# 10 是盐轮数（值越大越安全但越慢，10~12 是常用范围）
BCRYPT_SALT_ROUNDS=10 


# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0